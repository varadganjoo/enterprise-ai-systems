# ==============================================================================
# Enterprise AI Systems Engineering Suite - Environment Configuration
# ==============================================================================
# Copy this file to .env and set your Google Gemini API key.
# All 9 systems use Gemini for embeddings, fast-path routing, and reasoning models.
# No other external API keys are required.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHEAP_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
